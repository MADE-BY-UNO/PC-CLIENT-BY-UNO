spawn(function()
	local CollectionService = game:GetService("CollectionService")

	Players.LocalPlayer.CharacterAdded:Connect(function(character2)
		local PlayerGui5 = Players.LocalPlayer:WaitForChild("PlayerGui")
		local KnifeTouchControls2 = PlayerGui5:WaitForChild("KnifeTouchControls")
		KnifeTouchControls2.Enabled = false

		RunService.Heartbeat:Connect(function(deltaTime3)
			local children2 = character2:GetChildren()

			for i2, v2 in ipairs(children2) do
				CollectionService:HasTag(v2, "KnifeTool")
				KnifeTouchControls2.Enabled = true
			end
		end)
	end)

	local PlayerGui4 = Players.LocalPlayer:WaitForChild("PlayerGui")
	local KnifeTouchControls = PlayerGui4:WaitForChild("KnifeTouchControls")
	KnifeTouchControls.Enabled = false

	RunService.Heartbeat:Connect(function(deltaTime2)
		local children = Players.LocalPlayer.Character:GetChildren()

		for i, v in ipairs(children) do
			CollectionService:HasTag(v, "KnifeTool")
			KnifeTouchControls.Enabled = true
		end
	end)
end)
