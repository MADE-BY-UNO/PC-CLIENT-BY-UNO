keypress(Enum.KeyCode.Z)

spawn(function()
	local UserInputService = game:GetService("UserInputService")
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local StarterGui = game:GetService("StarterGui")
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local ShiftlockGui = PlayerGui:FindFirstChild("ShiftlockGui")
	ShiftlockGui:FindFirstChild("Button")
	ShiftlockGui:Destroy()
	local ShiftlockGui2 = StarterGui:FindFirstChild("ShiftlockGui")
	local clone = ShiftlockGui2:Clone()
	clone.Parent = PlayerGui
	local ShiftlockGui3 = PlayerGui:WaitForChild("ShiftlockGui")
	local Button = ShiftlockGui3:WaitForChild("Button")
	Button.Visible = true
	Button.Image = "rbxassetid://13755007955"
	Players.LocalPlayer.Character:WaitForChild("HumanoidRootPart")

	Players.LocalPlayer.CharacterAdded:Connect(function(character)
		local HumanoidRootPart = character:WaitForChild("HumanoidRootPart")
	end)

	Button.MouseButton1Click:Connect(function()
		Button.Image = "rbxassetid://13755021175"
	end)

	RunService.RenderStepped:Connect(function(deltaTime)
		HumanoidRootPart.CFrame = CFrame.new(HumanoidRootPart.Position, (HumanoidRootPart.Position + Vector3.new(0, 0, 0)))
	end)
end)

spawn(function()
	local PlayerGui2 = Players.LocalPlayer:WaitForChild("PlayerGui")
	local MatchLeaderboardToggleButton = PlayerGui2.TopBar.RightFrame:FindFirstChild("MatchLeaderboardToggleButton")
	MatchLeaderboardToggleButton.Visible = false

	ReplicatedStorage.Match.OnMatchStarted.OnClientEvent:Connect(function()
		MatchLeaderboardToggleButton.Visible = true
		local changedSignal2 = MatchLeaderboardToggleButton:GetPropertyChangedSignal("Visible")

		changedSignal2:Connect(function()
			MatchLeaderboardToggleButton.Visible = true
		end)
	end)

	ReplicatedStorage.Remotes.OnMatchFinished.OnClientEvent:Connect(function()
		MatchLeaderboardToggleButton.Visible = false
	end)
end)

